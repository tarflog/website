---
layout: base.njk
---

{% set hasCasePage = caseFile and (caseFile.fragments.length > 1 or caseFile.retention) %}
{% set subjectTopic = topic or caseFile.topic %}
{% set altSubject = subjectTopic or caseFile.subject %}
<main class="wrap entry">
  <nav class="dateline registry-link" aria-label="Breadcrumb">
    <a href="{{ '/' | url }}">THE LOG</a> ·
    <a href="{{ '/archive/' | url }}">REGISTRY</a> ·
    <span aria-current="page">FRAGMENT {{ file }}</span>
  </nav>

  <article class="doc corner entrycard">
    <span class="stamp small stamp-over">{% if rubric == 'RESTRICTED' %}Sealed{% else %}Declassified{% endif %}</span>

    <div class="file"><span class="grp">OBSERVATION LOG — EARTH{% if incident %} <span class="inc-tag">INCIDENT № {{ incident | pad2 }}</span>{% endif %}</span></div>
    <h1 class="day"><b>FRAGMENT {{ file }}</b>{% if subjectTopic %} · <b>{{ subjectTopic }}</b>{% endif %} · {{ rubric }}</h1>

    {% if caseFile %}
    <p class="subject">SUBJECT · {% if hasCasePage %}<a href="{{ ('/case/' + caseFile.key + '/') | url }}">{{ caseFile.subject }}</a>{% else %}{{ caseFile.subject }}{% endif %}</p>
    {% endif %}
    <p class="dateline">LOG DAY {{ day }}</p>
    <div class="body text">
      {% if redact %}{{ content | replace(redact, '<span class="redacted">' + redact + '</span>') | safe }}
      {% else %}{{ content | safe }}{% endif %}
    </div>
    <div class="foot"><span>FILE {{ file }}</span><span>DECLASSIFIED <time datetime="{{ declassified | isoDate }}">{{ declassified | isoDate }}</time></span></div>
  </article>

  {% if caseFile.retention %}
  {% set r = caseFile.retention %}
  <section class="dossier casebox">
    <div class="head">
      <h2>RETENTION SCHEDULE · {{ caseFile.subject | upper }}</h2>
      <span class="stamp small">{{ caseFile.status or "Partial" }}</span>
    </div>
    <table class="retention">
      <tr><th>{{ r.unit }}</th><td class="st">STATUS</td><td class="nt">NOTE</td></tr>
      {% for row in r.rows %}
      <tr class="{% if 'RELEASED' in row.status %}rel{% else %}wh{% endif %}">
        <th>{{ row.range }}</th>
        <td class="st">{{ row.status }}</td>
        <td class="nt">{{ row.note }}</td>
      </tr>
      {% endfor %}
    </table>
    <p class="selfnote">{{ r.total }} {{ r.unit | lower }} on file. The schedule is maintained by the archive, not by the observer.</p>
  </section>
  {% endif %}

  {% if caseFile.record %}
  <section class="dossier casebox">
    <div class="head"><h2>YOUR RECORD · THIS FILE</h2></div>
    <table class="twocol">
      <tr><th>YOUR RECORD</th><td>THIS FILE</td></tr>
      {% for row in caseFile.record %}
      <tr><th>{{ row[0] }}</th><td>{{ row[1] }}</td></tr>
      {% endfor %}
    </table>
    <p class="selfnote">Discrepancies are recorded, not resolved.</p>
  </section>
  {% endif %}

  {% if plate %}
  {% set plateSubject = (", subject " + altSubject) if altSubject else "" %}
  {% set plateRubric = (", rubric " + (rubric | lower)) if rubric else "" %}
  {% set plateAlt = "Photographic appendix to fragment " + file + plateSubject + plateRubric + "." %}
  <figure class="photo-doc appendix">
    {% picture "assets/fragments/" + (file | lower) + "-plate.jpg", plateAlt, [400, 800], "(min-width:800px) 760px, 100vw", { "loading": "lazy" } %}
    <span class="stamp small">Appendix</span>
    <figcaption class="cap"><span>PHOTOGRAPHIC APPENDIX · {{ file }}-A</span><span>UNATTRIBUTED</span></figcaption>
  </figure>
  {% endif %}

  {% if hasCasePage %}
  {% set siblings = [] %}
  {% for e in collections.log %}
    {% if e.url != page.url %}
      {% for slug in caseFile.fragments %}
        {% if e.url == ('/log/' + slug + '/') %}{% set siblings = (siblings.push(e), siblings) %}{% endif %}
      {% endfor %}
    {% endif %}
  {% endfor %}
  <section class="dossier casebox">
    <div class="head"><h2>{% if siblings.length %}ALSO IN THIS FILE{% else %}FILED UNDER · {{ caseFile.subject | upper }}{% endif %}</h2></div>
    {% if siblings.length %}
    <table class="registry">
      {% for e in siblings %}
      <tr>
        <th><a href="{{ e.url | url }}">{{ e.data.file }}</a></th>
        <td class="lede"><a href="{{ e.url | url }}">{{ e.content | striptags | truncate(84) | safe }}</a></td>
      </tr>
      {% endfor %}
    </table>
    <p class="selfnote"><a href="{{ ('/case/' + caseFile.key + '/') | url }}">Open the whole file →</a></p>
    {% else %}
    <p class="selfnote">No other fragment of this file is declassified.
      <a href="{{ ('/case/' + caseFile.key + '/') | url }}">Open the file →</a></p>
    {% endif %}
  </section>
  {% else %}
  <section class="dossier casebox">
    <div class="head"><h2>{% if caseFile %}FILED UNDER · {{ caseFile.subject | upper }}{% else %}FILED SEPARATELY{% endif %}</h2></div>
    <p class="selfnote">{% if caseFile %}This file holds no other declassified fragment.{% else %}This fragment is not filed under a subject file.{% endif %}
      <a href="{{ '/archive/' | url }}">Open the registry →</a></p>
  </section>
  {% endif %}

  {% if video %}
  <section class="request">
    <p class="tag">APPENDIX · MOTION RECORD</p>
    <p>A motion record is held for this fragment. It is stored off this archive,
      on the platform that carries it. Nothing further is attached to the file.</p>
    <a class="btn" href="{{ video }}" target="_blank" rel="noopener">Open the motion record</a>
  </section>
  {% endif %}

  {% for c in site.channels %}{% if c.label == 'TELEGRAM' %}
  <section class="request">
    <p class="tag">NOTICE · CONTINUED DECLASSIFICATION</p>
    <p>Releases follow no schedule. Each fragment is announced on the archive
      channel on the day it opens, once.</p>
    <a class="btn" href="{{ c.url }}" target="_blank" rel="noopener">Telegram · {{ c.handle }}</a>
  </section>
  {% endif %}{% endfor %}

  <section class="request">
    <p class="tag">FORM 7-C · REQUEST FOR DECLASSIFICATION</p>
    <p>Material withheld from this file may be requested. Requests are logged.
      Most are refused. The refusal is also logged.</p>
    <a class="btn" href="mailto:{{ site.email }}?subject={{ ('Declassification request — ' + file) | urlencode }}&amp;body={{ ('File: ' + file + '\nRequested: ') | urlencode }}">File a request</a>
  </section>

  {% set entries = collections.log %}
  {% for e in entries %}{% if e.url == page.url %}
    {% set nxt = entries[loop.index0 - 1] %}
    {% set prv = entries[loop.index0 + 1] %}
    {% if prv or nxt %}
    <nav class="pager" aria-label="Adjacent by declassification date">
      <span>{% if prv %}<a href="{{ prv.url | url }}">← {{ prv.data.file }}</a>{% endif %}</span>
      <span>{% if nxt %}<a href="{{ nxt.url | url }}">{{ nxt.data.file }} →</a>{% endif %}</span>
    </nav>
    <p class="dateline">ADJACENT BY DECLASSIFICATION DATE, NOT BY SUBJECT.</p>
    {% endif %}
  {% endif %}{% endfor %}
</main>
